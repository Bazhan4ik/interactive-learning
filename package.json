{
	"name": "learn",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#engine": "./src/lib/engine/index.ts",
		"#engine/svelte": "./src/lib/engine/render/svelte/index.ts",
		"#library": "./src/lib/library/index.ts",
		"#library/catalog": "./src/lib/library/catalog.ts",
		"#lesson": "./src/lib/lesson/index.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.2"
	},
	"engines": {
		"node": ">=22.17"
	},
	"dependencies": {
		"katex": "^0.19.1",
		"marked": "^18.3.0"
	}
}
